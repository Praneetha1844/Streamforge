# Copy to .env and fill in. Never commit .env.

# --- docker compose (local stack) ---
# Use URL-safe characters only: the password is embedded in a connection URL.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- application settings (prefix SF_) ---
SF_QUEUE_BACKEND=local            # local | pubsub
SF_STORE_BACKEND=memory           # memory | postgres
# SF_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Required when SF_QUEUE_BACKEND=pubsub
# SF_PUBSUB_PROJECT=<gcp-project-id>
# SF_PUBSUB_TOPIC=<topic-name>
# SF_PUBSUB_SUBSCRIPTION=<subscription-name>

SF_MAX_DELIVERY_ATTEMPTS=5
SF_BATCH_SIZE=100
SF_POLL_INTERVAL_SECONDS=1.0
SF_METRICS_PORT=9100
SF_LOG_LEVEL=INFO
SF_API_HOST=127.0.0.1
SF_API_PORT=8000
