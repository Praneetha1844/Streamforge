{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order.placed v2",
  "description": "Adds the optional channel field. Backward compatible with v1 consumers of the stored data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "customer_id", "items", "currency"],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "customer_id": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" },
    "channel": { "type": "string", "enum": ["web", "mobile", "store"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "qty", "unit_price_cents"],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "qty": { "type": "integer", "minimum": 1 },
          "unit_price_cents": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
